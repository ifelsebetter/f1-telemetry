# =============================================================================
# F1 Telemetry Platform — Environment Configuration Example
# Copy to .env to customize local or Docker settings:
#   cp .env.example .env
# =============================================================================

# Application metadata
F1_APP_TITLE="F1 Telemetry Platform"
F1_APP_VERSION="0.2.0"
F1_LOG_LEVEL="INFO"

# CORS Allowed Origins (JSON array or comma-separated)
F1_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# FastF1 Cache Directory (relative to /app inside container or project root locally)
F1_FASTF1_CACHE_DIR=".fastf1_cache"

# Background Ingestion Scheduler
F1_ENABLE_SCHEDULED_INGESTION="false"
F1_INGESTION_INTERVAL_MINUTES="30"

# Host Port Mappings (Docker Compose)
FRONTEND_PORT=3000
BACKEND_PORT=8000
